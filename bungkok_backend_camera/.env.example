# Koneksi Database (Gunakan PostgreSQL Supabase untuk cloud, atau biarkan kosong untuk SQLite lokal)
# DATABASE_URL=postgresql://postgres.gmasqrgtzceaariaucuw:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Domain Frontend yang diizinkan CORS (pisahkan dengan koma atau gunakan *)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_APP_URL=http://localhost:5173/app/dashboard

# Pengaturan Upload dan Kalibrasi
MAX_UPLOAD_MB=5
CALIBRATION_TTL_MINUTES=60

# Supabase Auth: URL + publishable/anon key digunakan untuk memverifikasi Bearer token.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Hanya email yang ditulis persis di sini mendapat dashboard admin. Pisahkan dengan koma.
ADMIN_EMAILS=admin@example.com

# Diperlukan agar fitur hapus akun juga menghapus identitas Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
